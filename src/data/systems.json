  "systems": [
    {
      "id": "motor",
      "name": "Motor system",
      "category": "cortex",
      "summary": "How a movement is planned, gated, refined and sent to muscle.",
      "flagship": true,
      "stages": [
        {
          "title": "Forming the intention",
          "body": "Voluntary movement begins before any muscle twitches. The prefrontal cortex decides to act; the premotor cortex and supplementary motor area (SMA) assemble the spatial plan and the sequence - which muscles, in what order, with what timing.",
          "structureIds": [
            "cortex.superior-frontal-gyrus.left",
            "cortex.superior-frontal-gyrus.right",
            "cortex.middle-frontal-gyrus.left",
            "cortex.middle-frontal-gyrus.right",
            "cortex.precentral-sulcus-superior-part.left",
            "cortex.precentral-sulcus-superior-part.right",
            "cortex.precentral-sulcus-inferior-part.left",
            "cortex.precentral-sulcus-inferior-part.right"
          ]
        },
        {
          "title": "The command - primary motor cortex",
          "body": "The plan converges on the precentral gyrus (M1). Its giant Betz cells are arranged as the motor homunculus, a distorted body map where the hand and face claim huge territory. M1 is the origin of the corticospinal tract.",
          "structureIds": [
            "cortex.precentral-sulcus-superior-part.left",
            "cortex.precentral-sulcus-superior-part.right",
            "cortex.precentral-sulcus-inferior-part.left",
            "cortex.precentral-sulcus-inferior-part.right",
            "cortex.precentral-gyrus.left",
            "cortex.precentral-gyrus.right"
          ]
        },
        {
          "title": "The basal ganglia loop - go / no-go",
          "body": "Before the command leaves, a cortico-striato-pallido-thalamic loop scales it. The direct pathway ('go') releases movement; the indirect pathway ('no-go') suppresses unwanted movement. Dopamine from the substantia nigra biases the loop toward action - its loss is the lesion of Parkinson's disease.",
          "structureIds": [
            "cortex.precentral-gyrus.left",
            "cortex.precentral-gyrus.right",
            "deep-grey.caudate-nucleus.right",
            "deep-grey.caudate-nucleus.left",
            "deep-grey.putamen.right",
            "deep-grey.putamen.left",
            "deep-grey.globus-pallidus-external.left",
            "deep-grey.globus-pallidus-external.right",
            "deep-grey.globus-pallidus-internal.left",
            "deep-grey.globus-pallidus-internal.right",
            "deep-grey.substantia-nigra.left",
            "deep-grey.substantia-nigra.right",
            "diencephalon.ventral-anterior-nucleus.left",
            "diencephalon.ventral-anterior-nucleus.right",
            "diencephalon.ventral-lateroventral-nucleus.left",
            "diencephalon.ventral-lateroventral-nucleus.right",
            "diencephalon.ventral-laterodorsal-nucleus.left",
            "diencephalon.ventral-laterodorsal-nucleus.right"
          ]
        },
        {
          "title": "Fine-tuning - the cerebellar loop",
          "body": "In parallel, a copy of the command reaches the cerebellum via the pons. The cerebellum compares intended against actual movement and sends correction back through the thalamus, smoothing timing and coordination. Damage causes ataxia, not paralysis.",
          "structureIds": [
            "cortex.precentral-gyrus.left",
            "cortex.precentral-gyrus.right",
            "brainstem.pons.right",
            "brainstem.pons.left",
            "cerebellum.culmen.median",
            "cerebellum.declive.median",
            "cerebellum.central-lobule.median",
            "cerebellum.tuber-of-vermis.median",
            "cerebellum.anterior-quadrangular-lobule.left",
            "cerebellum.anterior-quadrangular-lobule.right",
            "diencephalon.ventral-anterior-nucleus.left",
            "diencephalon.ventral-anterior-nucleus.right",
            "diencephalon.ventral-lateroventral-nucleus.left",
            "diencephalon.ventral-lateroventral-nucleus.right",
            "diencephalon.ventral-laterodorsal-nucleus.left",
            "diencephalon.ventral-laterodorsal-nucleus.right"
          ]
        },
        {
          "title": "The descending highway",
          "body": "The refined command travels down the corticospinal tract, through the internal capsule, the midbrain, and the pyramids of the medulla. This is the great motor expressway from cortex to cord.",
          "structureIds": [
            "cortex.precentral-gyrus.left",
            "cortex.precentral-gyrus.right",
            "tracts.corticospinal-tract.left",
            "tracts.corticospinal-tract.right",
            "brainstem.midbrain.right",
            "brainstem.midbrain.left",
            "brainstem.pons.right",
            "brainstem.pons.left",
            "brainstem.medulla-oblongata.left",
            "brainstem.pyramid-of-medulla-oblongata.left",
            "brainstem.pyramid-of-medulla-oblongata.right"
          ]
        },
        {
          "title": "Crossing over & the final common path",
          "body": "At the pyramidal decussation in the lower medulla, about 85% of fibres cross, which is why the left brain moves the right body. They synapse on lower motor neurons in the spinal cord: the 'final common pathway' to muscle.",
          "structureIds": [
            "brainstem.medulla-oblongata.left",
            "brainstem.pyramid-of-medulla-oblongata.left",
            "brainstem.pyramid-of-medulla-oblongata.right",
            "brainstem.pyramid-of-medulla-oblongata.left",
            "brainstem.pyramid-of-medulla-oblongata.right"
          ]
        }
      ]
    },
    {
      "id": "visual",
      "name": "Visual processing",
      "category": "cortex",
      "summary": "Retina to LGN to V1, then the dorsal \"where\" and ventral \"what\" streams.",
      "flagship": false,
      "stages": [
        {
          "title": "Eye to thalamus",
          "body": "Signals leave the retina along the optic nerve, partially cross at the optic chiasm, and relay in the lateral geniculate nucleus (LGN) of the thalamus.",
          "structureIds": [
            "cranial-nerves.optic-nerve-ii.left",
            "cranial-nerves.optic-nerve-ii.right",
            "diencephalon.optic-chiasm.right",
            "diencephalon.optic-chiasm.left",
            "diencephalon.lateral-geniculate-body.right",
            "diencephalon.lateral-geniculate-body.left"
          ]
        },
        {
          "title": "Primary visual cortex (V1)",
          "body": "The LGN projects to V1, the first cortical visual area: the striate cortex lining the calcarine sulcus, with its central-vision representation at the occipital pole. Here orientation, edges and contrast are first extracted before anything splits into streams.",
          "structureIds": [
            "diencephalon.lateral-geniculate-body.right",
            "diencephalon.lateral-geniculate-body.left",
            "cortex.calcarine-sulcus.left",
            "cortex.calcarine-sulcus.right",
            "cortex.occipital-pole.left",
            "cortex.occipital-pole.right"
          ]
        },
        {
          "title": "The dorsal \"where\" stream",
          "body": "From V1 the dorsal stream passes through dorsal extrastriate cortex (the cuneus) to area MT and the parietal cortex, coding motion, location and visually-guided action.",
          "structureIds": [
            "cortex.calcarine-sulcus.left",
            "cortex.calcarine-sulcus.right",
            "cortex.occipital-pole.left",
            "cortex.occipital-pole.right",
            "cortex.cuneus.left",
            "cortex.cuneus.right",
            "cortex.lateral-occipital-gyrus-middle-occipital-gyrus.left",
            "cortex.lateral-occipital-gyrus-middle-occipital-gyrus.right",
            "cortex.superior-parietal-lobule.left",
            "cortex.superior-parietal-lobule.right",
            "cortex.intraparietal-sulcus.left",
            "cortex.intraparietal-sulcus.right"
          ]
        },
        {
          "title": "The ventral \"what\" stream",
          "body": "The ventral stream runs to inferior temporal cortex, coding form, colour and object/face identity.",
          "structureIds": [
            "cortex.calcarine-sulcus.left",
            "cortex.calcarine-sulcus.right",
            "cortex.occipital-pole.left",
            "cortex.occipital-pole.right",
            "cortex.lingual-gyrus.left",
            "cortex.lingual-gyrus.right",
            "cortex.lateral-occipitotemporal-gyrus.left",
            "cortex.lateral-occipitotemporal-gyrus.right",
            "cortex.inferior-temporal-gyrus.left",
            "cortex.inferior-temporal-gyrus.right"
          ]
        }
      ]
    },
    {
      "id": "auditory",
      "name": "Auditory pathway",
      "category": "cortex",
      "summary": "Cochlea to brainstem nuclei to MGN to primary auditory cortex.",
      "flagship": false,
      "stages": [
        {
          "title": "Into the brainstem",
          "body": "Auditory nerve fibres synapse in the cochlear nuclei of the brainstem, the first central relay.",
          "structureIds": [
            "brainstem.vestibular-nuclei.left",
            "brainstem.vestibular-nuclei.right",
            "brainstem.pons.right",
            "brainstem.pons.left"
          ]
        },
        {
          "title": "Thalamic relay",
          "body": "The pathway ascends to the medial geniculate nucleus (MGN) of the thalamus.",
          "structureIds": [
            "brainstem.vestibular-nuclei.left",
            "brainstem.vestibular-nuclei.right",
            "diencephalon.medial-geniculate-body.right",
            "diencephalon.medial-geniculate-body.left"
          ]
        },
        {
          "title": "Auditory cortex",
          "body": "The MGN projects to Heschl's gyrus (A1) in the superior temporal lobe, tonotopically mapped by frequency.",
          "structureIds": [
            "diencephalon.medial-geniculate-body.right",
            "diencephalon.medial-geniculate-body.left",
            "cortex.transverse-temporal-gyri.left",
            "cortex.transverse-temporal-gyri.right"
          ]
        }
      ]
    },
    {
      "id": "somatosensory",
      "name": "Somatosensory pathway",
      "category": "cortex",
      "summary": "Body to spinal cord to medulla to thalamus to primary somatosensory cortex.",
      "flagship": false,
      "stages": [
        {
          "title": "Ascending the cord",
          "body": "Touch and proprioception ascend the dorsal columns of the spinal cord to the medulla.",
